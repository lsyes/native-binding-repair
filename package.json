{
  "name": "native-binding-repair",
  "version": "0.1.0",
  "description": "Diagnose and automatically repair missing or unloadable native Node.js bindings: build prebuilds for unsupported platforms/architectures, or fall back to WebAssembly.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "bin": {
    "nbr": "bin/nbr.js",
    "native-binding-repair": "bin/nbr.js"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./preload": "./lib/preload.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "vendor",
    "!vendor/node-addon-require-builtin-src",
    "README.md"
  ],
  "scripts": {
    "test": "node test/run.js",
    "doctor": "node bin/nbr.js doctor",
    "build:prebuild": "node scripts/build-require-builtin-prebuild.js"
  },
  "keywords": [
    "native",
    "addon",
    "prebuild",
    "binding",
    "sharp",
    "loongarch",
    "loong64",
    "node-gyp",
    "wasm"
  ]
}
